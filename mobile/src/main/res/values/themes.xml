<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SchatkamerMobile" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/brand_amber</item>
        <item name="colorPrimaryDark">@color/brand_ink</item>
        <item name="colorAccent">@color/brand_amber</item>
        <item name="android:windowBackground">@color/brand_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.SchatkamerMobile.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_emblem</item>
        <item name="postSplashScreenTheme">@style/Theme.SchatkamerMobile</item>
    </style>
</resources>
