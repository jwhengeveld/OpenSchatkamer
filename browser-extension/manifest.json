{
  "manifest_version": 3,
  "name": "Schatkamer Downloader",
  "version": "1.1.1",
  "description": "Download onversleutelde audio en video uit De Schatkamer van Beeld en Geluid als MP4/M4A voor offline gebruik.",
  "minimum_chrome_version": "116",
  "permissions": [
    "downloads",
    "offscreen"
  ],
  "host_permissions": [
    "https://schatkamer.beeldengeluid.nl/*",
    "https://*.beeldengeluid.nl/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://schatkamer.beeldengeluid.nl/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Schatkamer Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
